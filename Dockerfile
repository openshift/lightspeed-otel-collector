# Stage 1: Build the collector binary from pre-generated source.
# Source in cmd/otelcol-lightspeed/ is generated by OCB (make generate)
# and committed to the repo for hermetic CI builds.
FROM registry.redhat.io/ubi9/go-toolset:9.8-1787774815 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace

# Cache module downloads — copy go.mod/go.sum first so source changes
# don't invalidate the download layer.
COPY cmd/otelcol-lightspeed/go.mod cmd/otelcol-lightspeed/go.sum cmd/otelcol-lightspeed/
COPY postgresexporter/go.mod postgresexporter/go.sum postgresexporter/
COPY extension/postgresadmin/go.mod extension/postgresadmin/go.sum extension/postgresadmin/
COPY extension/httpsmetrics/go.mod extension/httpsmetrics/go.sum extension/httpsmetrics/
RUN cd cmd/otelcol-lightspeed && go mod download

# Copy source.
COPY cmd/ cmd/
COPY postgresexporter/ postgresexporter/
COPY extension/ extension/

USER root

# Build with Go's native FIPS 140-3 crypto provider (pure Go, no CGo/OpenSSL).
# GOFIPS140=certified selects the certified FIPS module; the binary defaults
# to fips140=on (see the //go:debug directive in
# cmd/otelcol-lightspeed/fips.go), keeping FIPS-approved crypto always active
# (matching the previous strictfipsruntime behavior).
# GOAMD64 is only consulted when GOARCH=amd64; it is silently ignored for
# other target architectures (arm64 etc.), so multi-arch builds are unaffected.
RUN cd cmd/otelcol-lightspeed && \
    CGO_ENABLED=0 GOFIPS140=certified GOAMD64=v2 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -a -trimpath -o /workspace/otelcol-lightspeed .
# Verify otelcol-lightspeed targets at most x86-64-v2 (no-op on non-amd64)
RUN cd cmd/check-isa-level && go build -o /workspace/check-isa-level . && cd /workspace && ./check-isa-level otelcol-lightspeed


# Stage 2: Minimal runtime image.
FROM registry.access.redhat.com/ubi9-micro:9.9-1794478307@sha256:dbd325b96bcd432dd42816d31412bdf1dc0fb973b79ed310344bc23c76c068db

WORKDIR /

COPY --from=builder /workspace/otelcol-lightspeed .

# Red Hat certification requires LICENSE under /licenses/.
RUN mkdir /licenses
COPY LICENSE /licenses/.

LABEL name="openshift-lightspeed/otelcol-lightspeed-rhel9" \
      summary="Custom OpenTelemetry Collector for OpenShift Lightspeed" \
      description="Receives OTLP telemetry, writes logs to PostgreSQL, and exports allowlisted traces for data collection as native OTLP JSONL." \
      io.k8s.display-name="OTel Collector — Lightspeed" \
      io.k8s.description="Custom OpenTelemetry Collector distribution that writes logs to PostgreSQL and exports allowlisted traces for data collection as native OTLP JSONL." \
      io.openshift.tags="opentelemetry,otel,collector,postgres,logs,traces,jsonl" \
      cpe="cpe:/a:redhat:openshift_lightspeed:2::el9"

# OTLP gRPC/HTTP, health check, admin API, and metrics ports.
EXPOSE 4317 4318 8080 8888 13133

# Run as non-root, same UID as lightspeed-operator.
USER 65532:65532

ENTRYPOINT ["/otelcol-lightspeed"]
